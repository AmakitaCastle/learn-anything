    {
      "type": "board.remove",
      "when": {
        "segment": "rate",
        "phrase": "第二段也经过一分钟"
      },
      "id": "dt1"
    },
    {
      "type": "board.write",
      "when": {
        "segment": "rate",
        "phrase": "第二段也经过一分钟"
      },
      "item": {
        "id": "dt2",
        "text": "时间差② = 2 − 1 = 1 min",
        "tone": "plain",
        "kind": "formula"
      }
    },
    {
      "type": "board.write",
      "when": {
        "segment": "rate",
        "phrase": "十除以一等于每分钟十摄氏度"
      },
      "item": {
        "id": "rate2",
        "text": "平均速度② = 10 / 1 = 10°C/min",
        "tone": "accent",
        "kind": "formula"
      }
    },
    {
      "type": "board.remove",
      "when": {
        "segment": "conclude"
      },
      "id": "delta2"
    },
    {
      "type": "board.remove",
      "when": {
        "segment": "conclude"
      },
      "id": "dt2"
    },
    {
      "type": "visual",
      "when": {
        "segment": "conclude",
        "phrase": "最后比较"
      },
      "visualId": "reasoning",
      "action": "activate",
      "payload": {
