        "tone": "muted"
      }
    },
    {
      "type": "board.remove",
      "when": {
        "segment": "conclude",
        "phrase": "不等于"
      },
      "id": "question"
    },
    {
      "type": "board.write",
      "when": {
        "segment": "conclude",
        "phrase": "不等于"
      },
      "item": {
        "id": "conclusion",
        "text": "温度升高 ≠ 升温加快",
        "tone": "strong",
        "kind": "formula"
      }
    }
  ]
}
