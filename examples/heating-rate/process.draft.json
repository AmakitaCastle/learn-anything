      "when": {
        "segment": "conclude",
        "phrase": "十小于二十"
      },
      "item": {
        "id": "compare",
        "text": "10 < 20：后一区间平均速度更小",
        "tone": "accent",
        "kind": "formula"
      }
    },
    {
      "type": "visual",
      "when": {
        "segment": "conclude",
