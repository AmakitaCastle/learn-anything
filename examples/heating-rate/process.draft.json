      "when": {
        "segment": "conclude",
        "phrase": "温度仍然升高"
      },
      "id": "formula"
    },
    {
      "type": "board.write",
      "when": {
        "segment": "conclude",
        "phrase": "温度仍然升高"
      },
      "item": {
        "id": "result",
        "text": "温度上升；区间平均速度下降",
        "tone": "strong"
      }
    },
    {
      "type": "board.remove",
      "when": {
        "segment": "conclude",
        "phrase": "三个测量点"
      },
      "id": "compare"
    },
    {
      "type": "board.write",
      "when": {
        "segment": "conclude",
        "phrase": "不能证明"
      },
      "item": {
        "id": "boundary",
