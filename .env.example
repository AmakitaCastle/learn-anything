# 从豆包语音控制台获取语音 API Key，不是方舟文本模型的 API Key。
# 在本地 .env.local 中填写；不要提交或发送真实密钥。
# 可选：自部署或第三方服务兼容豆包 V3 HTTP/SSE 协议时，填写完整接口地址。
# 例如 http://192.168.1.20:8000/api/v3/tts/unidirectional/sse
# 留空使用豆包官方接口。自定义接口允许下方 API Key 与 Resource ID 留空。
DOUBAO_TTS_ENDPOINT=
DOUBAO_SPEECH_API_KEY=
# 与账号开通的模型版本及所选音色匹配；示例使用 2.0。
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
# 从语音控制台选择音色并复制完整 speaker ID，不填展示名称。
DOUBAO_TTS_SPEAKER=
# 0 为正常语速，范围 -50 到 100；不是播放器倍速。
DOUBAO_TTS_SPEECH_RATE=0

# 上游文稿生成（与上面的语音服务配置互不相干）。
# 协议：openai-compatible / anthropic / gemini。
# 明确填写账号可用的模型 ID，不自动选择模型。
LESSON_LLM_PROVIDER=openai-compatible
LESSON_LLM_MODEL=
LESSON_LLM_API_KEY=
# 可选：供应商 API 根地址，包含版本路径，不含 /chat/completions 等动作路径。
# OpenAI 默认 https://api.openai.com/v1；其他兼容厂商填写自己的根地址。
LESSON_LLM_BASE_URL=
